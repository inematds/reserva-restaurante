"""
import json
import os
import pathlib
import shutil
import signal
import subprocess
import threading
import unicodedata
import urllib.error
import urllib.request

import pytest

RAIZ = pathlib.Path(__file__).resolve().parent.parent
FIXTURE = pathlib.Path(__file__).resolve().parent / "fixtures" / "restaurante.json"
TOKEN = "segredo-teste"
AGORA = "2026-10-06T10:00"  # terça-feira; almoço 11:30–15:00 e jantar 19:00–23:00 na fixture


def norm(s):
    """Minúsculas e sem acento, para comparar trechos de resposta."""
    return "".join(c for c in unicodedata.normalize("NFD", s.lower()) if unicodedata.category(c) != "Mn")


class Cliente:
    def __init__(self, base):
        self.base = base

    def req(self, metodo, rota, corpo=None, token=TOKEN):
        dados = None if corpo is None else json.dumps(corpo).encode()
        r = urllib.request.Request(self.base + rota, data=dados, method=metodo)
        if dados is not None:
            r.add_header("Content-Type", "application/json")
        if token:
            r.add_header("X-Token", token)
        try:
            with urllib.request.urlopen(r, timeout=10) as resp:
                texto = resp.read().decode()
                return resp.status, (json.loads(texto) if texto and "json" in resp.headers.get("Content-Type", "") else texto)
        except urllib.error.HTTPError as e:
            texto = e.read().decode()
            try:
                return e.code, json.loads(texto)
            except ValueError:
                return e.code, texto

    def get(self, rota, **kw):
        return self.req("GET", rota, **kw)

    def post(self, rota, corpo=None, **kw):
        return self.req("POST", rota, {} if corpo is None else corpo, **kw)

    def put(self, rota, corpo, **kw):
        return self.req("PUT", rota, corpo, **kw)

    def delete(self, rota, **kw):
        return self.req("DELETE", rota, **kw)

    # atalhos (usam padrões da fixture; no verificar-independente passar tudo explícito)
    def cliente(self, nome="Maria Silva", telefone="(41) 99999-0001", marketing=False, **extra):
        corpo = {"nome": nome, "telefone": telefone, "consentimento_marketing": marketing, **extra}
        st, r = self.post("/api/clientes", corpo)
        assert st in (200, 201), (st, r)
        return r["id"]

    def reserva(self, cliente_id, inicio, pessoas=2, salao=None, mesa=None, **extra):
        corpo = {"cliente_id": cliente_id, "inicio": inicio, "pessoas": pessoas, **extra}
        if salao:
            corpo["salao"] = salao
        if mesa:
            corpo["mesa"] = mesa
        return self.post("/api/reservas", corpo)

    def horarios(self, data, pessoas=2, salao=None):
        rota = f"/api/horarios?data={data}&pessoas={pessoas}" + (f"&salao={salao}" if salao else "")
        st, r = self.get(rota, token=None)
        assert st == 200, (st, r)
        return [h["inicio"] for h in r["horarios"]]

    def msg(self, telefone, texto):
        st, r = self.post("/api/mensagens", {"telefone": telefone, "texto": texto}, token=None)
        assert st == 200, (st, r)
        return "\n".join(r["respostas"])

    def saida(self, tipo=None):
        st, r = self.get("/api/saida")
        assert st == 200, (st, r)
        return [m for m in r["mensagens"] if tipo is None or m["tipo"] == tipo]

    def reservas(self, data, **filtros):
        rota = f"/api/reservas?data={data}" + "".join(f"&{k}={v}" for k, v in filtros.items())
        st, r = self.get(rota)
        assert st == 200, (st, r)
        return r["reservas"]

    def por_id(self, data, reserva_id):
        return next(x for x in self.reservas(data) if x["id"] == reserva_id)


SERVIDORES = []


@pytest.fixture(autouse=True)
def _parar_servidores():
    """Derruba todo servidor subido no teste, mesmo quando uma asserção falha antes do parar() explícito
    (em 05/10 um `serve` ficou órfão 14 h no projeto irmão por isso)."""
