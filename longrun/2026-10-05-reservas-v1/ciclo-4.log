"""Persistência dos cadastros; cada operação usa sua própria conexão."""
from contextlib import contextmanager
import json
from pathlib import Path
import shutil
import sqlite3

ROOT = Path(__file__).resolve().parent.parent


class Store:
    def __init__(self, directory):
        self.directory = Path(directory)
        self.directory.mkdir(parents=True, exist_ok=True)
        config = self.directory / "restaurante.json"
        if not config.exists():
            shutil.copyfile(ROOT / "exemplos/restaurante.json", config)
        self.config = json.loads(config.read_text(encoding="utf-8"))
        self.path = self.directory / "reservas.sqlite3"
        with self.transaction() as db:
            db.execute("CREATE TABLE IF NOT EXISTS metadata (chave TEXT PRIMARY KEY, valor TEXT)")
            db.execute("""CREATE TABLE IF NOT EXISTS cadastros (
                ordem INTEGER PRIMARY KEY AUTOINCREMENT,
                tipo TEXT NOT NULL, id TEXT NOT NULL, dados TEXT NOT NULL,
                UNIQUE(tipo, id))""")
            if not db.execute("SELECT 1 FROM metadata WHERE chave='semeado'").fetchone():
                for kind in ("mesas", "turnos", "faq"):
                    for item in self.config.get(kind, []):
                        item = dict(item)
                        if kind == "mesas":
                            item.setdefault("ativa", True)
                        if kind == "turnos":
                            item.setdefault("ativo", True)
                        self.insert(db, kind, item)
                db.execute("INSERT INTO metadata VALUES ('semeado', '1')")

    @contextmanager
    def transaction(self):
        db = sqlite3.connect(self.path, timeout=30)
        try:
            db.execute("BEGIN IMMEDIATE")
            yield db
            db.commit()
        except Exception:
            db.rollback()
            raise
        finally:
            db.close()

    @staticmethod
    def items(db, kind):
        return [json.loads(row[0]) for row in db.execute(
            "SELECT dados FROM cadastros WHERE tipo=? ORDER BY ordem", (kind,))]

    @staticmethod
    def insert(db, kind, item):
        db.execute("INSERT INTO cadastros(tipo,id,dados) VALUES (?,?,?)",
                   (kind, item["id"], json.dumps(item, ensure_ascii=False)))

    @staticmethod
    def update(db, kind, item):
        db.execute("UPDATE cadastros SET dados=? WHERE tipo=? AND id=?",
                   (json.dumps(item, ensure_ascii=False), kind, item["id"]))
import argparse

from .server import Application, make_server
from .storage import Store


def main():
    parser = argparse.ArgumentParser(description="Reservas de mesa para um restaurante")
    commands = parser.add_subparsers(dest="command", required=True)
    serve = commands.add_parser("serve", help="Iniciar o servidor HTTP")
    serve.add_argument("--porta", type=int, default=8080)
    serve.add_argument("--dados", required=True)
    serve.add_argument("--host", default="127.0.0.1")
    args = parser.parse_args()
    app = Application(Store(args.dados))
    with make_server(app, args.host, args.porta) as server:
        print(f"PORTA={server.server_address[1]}", flush=True)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            pass
"""HTTP JSON e autenticação central; regras de cadastros persistentes."""
from datetime import datetime
import hmac
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os
import re
from urllib.parse import urlsplit, parse_qs
from uuid import uuid4

from .storage import ROOT


from .booking import APIError, Booking


from .conversation import Conversation


class Application(Conversation, Booking):
    def __init__(self, store):
        self.store = store
        self.config = store.config
        fixed = os.environ.get("RESERVA_AGORA")
        self.fixed_now = datetime.strptime(fixed, "%Y-%m-%dT%H:%M") if fixed else None

    def now(self):
        return self.fixed_now or datetime.now().replace(second=0, microsecond=0)

    def dispatch(self, method, path, body, query=None):
        if path.split("/")[2:3] and path.split("/")[2] in ("mensagens", "saida", "espera", "tarefas", "campanhas", "atendimento-humano"):
            return self.conversation_dispatch(method, path, body, query or {})
        if path.split("/")[1:2] == ["api"] and path.split("/")[2:3] and path.split("/")[2] in ("clientes", "reservas", "horarios", "ocupacao"):
            return self.booking_dispatch(method, path, body, query or {})
        if method == "GET" and path == "/api/saude":
            return 200, {"ok": True, "versao": (ROOT / "VERSION").read_text().strip()}
        if method == "GET" and path == "/api/saloes":
            return 200, {"saloes": self.config["saloes"]}
        parts = path.strip("/").split("/")
        if len(parts) not in (2, 3) or parts[0] != "api" or parts[1] not in ("mesas", "turnos", "faq"):
            raise APIError(404, "rota_inexistente")
        kind = parts[1]
        identifier = parts[2] if len(parts) == 3 else None
        with self.store.transaction() as db:
            items = self.store.items(db, kind)
            existing = next((item for item in items if item["id"] == identifier), None)
            if identifier is not None and existing is None:
                raise APIError(404, "nao_encontrado")
