import sys, tempfile, shutil
from pathlib import Path
sys.path.insert(0, str(Path.cwd() / 'tests'))
from conftest import Servidor, FIXTURE, AGORA
with tempfile.TemporaryDirectory() as tmp:
    d=Path(tmp)
    shutil.copy(FIXTURE,d/'restaurante.json')
    server=Servidor(d)
    try:
        api=server.subir()
        old='11987654321'; new='11987654322'
        api.msg(old,'reservar')
        cid=api.cliente(nome='Cliente histórico',telefone=old)
        assert api.put('/api/clientes/'+cid,{'telefone':new})[0]==200
        data=api.get('/api/clientes/'+cid+'/dados')[1]
        assert any(m['texto']=='reservar' for m in data['mensagens'])
        second=api.cliente(nome='Outro cliente',telefone=old)
        assert not api.get('/api/clientes/'+second+'/dados')[1]['mensagens']
        assert api.delete('/api/clientes/'+second)[0]==204
        assert any(m['texto']=='reservar' for m in api.get('/api/clientes/'+cid+'/dados')[1]['mensagens'])
        slots=api.horarios(AGORA[:10])
        st,r=api.reserva(cid,slots[0]);assert st==201
        api.post('/api/tarefas/rodar')
        assert api.saida('confirmacao')
        assert api.post('/api/reservas/'+r['id']+'/remarcar',{'inicio':slots[1]})[0]==200
        api.msg(new,'1')
        assert api.por_id(AGORA[:10],r['id'])['status']=='reservada'
        assert api.post('/api/tarefas/rodar')[1]['enviadas']==1
        api.msg(new,'1')
        assert api.por_id(AGORA[:10],r['id'])['status']=='confirmada'
        print('REGRESSÕES OK: histórico preservado, telefone reutilizado isolado, anonimização isolada, confirmação antiga invalidada e nova confirmação aceita.')
    finally:
        server.parar()
EOF
