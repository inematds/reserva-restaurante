'use strict';
const form = document.querySelector('#conversa'), history = document.querySelector('#historico'), notice = document.querySelector('#aviso');
function line(text, own=false) { const li=document.createElement('li'); li.textContent=text; if(own)li.className='cliente'; history.append(li); li.scrollIntoView({block:'nearest'}); }
form.addEventListener('submit',async e=>{e.preventDefault();const button=form.querySelector('button'), text=form.elements.texto.value;button.disabled=true;notice.textContent='Enviando…';try{const response=await fetch('/api/mensagens',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({telefone:form.elements.telefone.value,texto:text})});const data=await response.json();if("'!response.ok)throw Error(data.erro);line(text,true);data.respostas.forEach(t=>line(t));form.elements.texto.value='"'';notice.textContent=data.respostas.length?'':'Mensagem recebida. A equipe está cuidando do seu atendimento.';}catch(error){notice.textContent='Não foi possível enviar: '+error.message+'. Confira o telefone e tente novamente.';}finally{button.disabled=false;form.elements.texto.focus();}});
EOF
